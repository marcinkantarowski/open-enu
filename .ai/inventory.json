                "UserDirectoryInterface"
            ],
            "entities": [
                "Membership",
                "RefreshToken",
                "SecurityToken",
                "User"
            ],
            "commands": [
                "RegisterUser",
                "RequestPasswordReset",
                "ResetPassword",
                "UpdateProfile",
                "VerifyEmail"
            ],
            "services": [
                "IdentityGdprSubject",
                "IdentityMailer",
                "LoginService",
                "PermissionResolver",
                "SecurityTokenIssuer",
                "SessionIssuer",
                "SessionMinter",
                "SessionPayload",
                "UserDirectory",
                "UserLocaleProvider"
            ],
            "repositories": [
                "MembershipRepository",
                "RefreshTokenRepository",
                "SecurityTokenRepository",
                "UserRepository"
            ],
            "console": [
                "CreateUserCommand"
