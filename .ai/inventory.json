            "entities": [
                "Attachment"
            ],
            "commands": [
                "UploadAttachment"
            ],
            "repositories": [
                "AttachmentRepository"
            ],
            "console": [
                "SweepOrphanAttachmentsCommand"
            ],
            "permissions": [
                "attachment.manage",
                "attachment.view"
            ],
            "routes": [
                "GET /api/attachments/{id} (attachment_show)",
                "POST /api/attachments (attachment_upload)"
            ]
        },
        "Audit": {
            "description": "The durable record of every change - who, what, when, and what it looked like before.",
            "slug": "audit",
            "depends": [
                "Tenant"
            ],
            "contracts": [
                "AuditReaderInterface"
            ],
            "entities": [
                "AuditEntry"
            ],
            "services": [
                "AuditGdprSubject",
                "AuditReader",
                "PersistentAuditLogger"
            ],
            "repositories": [
                "AuditEntryRepository"
            ],
            "permissions": [
                "audit.view"
            ],
            "routes": [
                "GET /api/audit (audit_index)"
            ]
        },
        "Example": {
            "description": "The reference module - one of every platform concern, and nothing else.",
            "slug": "example",
            "depends": [],
            "entities": [
                "Project"
            ],
            "commands": [
                "ArchiveProjects",
                "CreateProject",
                "RenameProject"
            ],
            "events": [
                "ProjectCreated"
            ],
            "services": [
                "ExampleFlags"
            ],
            "repositories": [
                "ProjectRepository"
            ],
            "messages": [
                "ArchiveProjectsJob"
            ],
            "permissions": [
                "example.manage",
                "example.view"
            ],
            "routes": [
                "GET /api/projects (example_project_index)",
                "GET /api/projects/{id} (example_project_show)",
                "PATCH /api/projects/{id} (example_project_rename)",
                "POST /api/projects (example_project_create)",
                "POST /api/projects/archive (example_project_archive)"
            ],
            "searchable": [
                {
                    "entity": "App\\Module\\Example\\Entity\\Project",
                    "fields": [
                        "name",
                        "description"
                    ],
                    "permission": "example.view"
                }
            ]
        },
        "Identity": {
            "description": "Users, their memberships of tenants, and everything that authenticates one.",
            "slug": "identity",
