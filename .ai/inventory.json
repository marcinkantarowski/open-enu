{
    "modules": {
        "ApiKey": {
            "description": "Machine credentials - scoped, revocable keys for clients that are not browsers.",
            "slug": "api_key",
            "depends": [
                "Tenant"
            ],
            "entities": [
                "ApiKey"
            ],
            "commands": [
                "CreateApiKey",
                "RevokeApiKey"
            ],
            "repositories": [
                "ApiKeyRepository"
            ],
            "console": [
                "CreateApiKeyCommand"
            ],
            "permissions": [
                "api_key.manage",
                "api_key.view"
            ],
            "routes": [
                "DELETE /api/api-keys/{id} (api_key_revoke)",
                "GET /api/api-keys (api_key_index)",
                "POST /api/api-keys (api_key_create)"
            ]
        },
        "Attachment": {
            "description": "Files any module can attach to its records, stored per tenant and served by expiring URL.",
            "slug": "attachment",
            "depends": [
                "Tenant"
