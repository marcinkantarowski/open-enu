{
    "name": "open-enu/app",
    "description": "OpenEnu API - application modules. The framework lives in open-enu/kernel.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "doctrine/doctrine-bundle": "^2.13",
        "doctrine/doctrine-migrations-bundle": "^3.4",
        "doctrine/orm": "^3.3",
        "league/flysystem": "^3.29",
        "lexik/jwt-authentication-bundle": "^3.1",
        "nelmio/api-doc-bundle": "^5.0",
        "nelmio/cors-bundle": "^2.6",
        "php": ">=8.4",
        "open-enu/kernel": "@dev",
        "symfony/console": "7.4.*",
        "symfony/doctrine-bridge": "7.4.*",
        "symfony/doctrine-messenger": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/expression-language": "7.4.*",
        "symfony/flex": "^2.11",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-client": "7.4.*",
        "symfony/mailer": "7.4.*",
        "symfony/mercure-bundle": "^0.5",
        "symfony/messenger": "7.4.*",
        "symfony/mime": "7.4.*",
        "symfony/monolog-bundle": "^3.10",
        "symfony/property-access": "7.4.*",
        "symfony/rate-limiter": "7.4.*",
        "symfony/redis-messenger": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/serializer": "7.4.*",
        "symfony/translation": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/uid": "7.4.*",
        "symfony/validator": "7.4.*",
        "symfony/yaml": "7.4.*"
    },
    "repositories": [
        {
            "type": "path",
            "url": "kernel",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/",
            "OpenEnu\\Kernel\\Tests\\": "kernel/tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^11.0",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*",
        "symfony/phpunit-bridge": "7.4.*"
    },
    "conflict": {
        "symfony/browser-kit": ">=8.0",
        "symfony/cache": ">=8.0",
        "symfony/clock": ">=8.0",
        "symfony/config": ">=8.0",
        "symfony/console": ">=8.0",
        "symfony/css-selector": ">=8.0",
        "symfony/dependency-injection": ">=8.0",
        "symfony/doctrine-bridge": ">=8.0",
        "symfony/doctrine-messenger": ">=8.0",
        "symfony/dom-crawler": ">=8.0",
        "symfony/dotenv": ">=8.0",
        "symfony/error-handler": ">=8.0",
        "symfony/event-dispatcher": ">=8.0",
        "symfony/expression-language": ">=8.0",
        "symfony/filesystem": ">=8.0",
        "symfony/finder": ">=8.0",
        "symfony/framework-bundle": ">=8.0",
        "symfony/http-client": ">=8.0",
        "symfony/http-foundation": ">=8.0",
        "symfony/http-kernel": ">=8.0",
        "symfony/mailer": ">=8.0",
        "symfony/messenger": ">=8.0",
        "symfony/mime": ">=8.0",
        "symfony/monolog-bridge": ">=8.0",
        "symfony/options-resolver": ">=8.0",
        "symfony/password-hasher": ">=8.0",
        "symfony/phpunit-bridge": ">=8.0",
        "symfony/process": ">=8.0",
        "symfony/property-access": ">=8.0",
        "symfony/property-info": ">=8.0",
        "symfony/rate-limiter": ">=8.0",
        "symfony/redis-messenger": ">=8.0",
        "symfony/routing": ">=8.0",
        "symfony/runtime": ">=8.0",
        "symfony/security-bundle": ">=8.0",
        "symfony/security-core": ">=8.0",
        "symfony/security-csrf": ">=8.0",
        "symfony/security-http": ">=8.0",
        "symfony/serializer": ">=8.0",
        "symfony/stopwatch": ">=8.0",
        "symfony/string": ">=8.0",
        "symfony/translation": ">=8.0",
        "symfony/twig-bridge": ">=8.0",
        "symfony/twig-bundle": ">=8.0",
        "symfony/type-info": ">=8.0",
        "symfony/uid": ">=8.0",
        "symfony/validator": ">=8.0",
        "symfony/var-dumper": ">=8.0",
        "symfony/var-exporter": ">=8.0",
        "symfony/web-link": ">=8.0",
        "symfony/yaml": ">=8.0"
    }
}
