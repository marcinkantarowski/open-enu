# Symfony's committed defaults. NO SECRETS BELONG HERE.
#
# Real values come from backend/.env.local, which is GENERATED from the
# repository-root .env by `make env` and is gitignored. Editing this file to
# configure your machine will not work - edit the root .env and re-run `make env`.
#
# Symfony loads, in increasing precedence:
#   .env  →  .env.local  →  .env.$APP_ENV  →  .env.$APP_ENV.local  →  real env vars
#
# See .ai/platform/PLAN.md §11.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
###< symfony/framework-bundle ###

# Placeholders only: every one of these is overridden by the generated
# .env.local. They exist so `bin/console` can boot in a checkout where `make env`
# has not been run yet, and so static analysis has something to resolve.
APP_STAGE=local
DEFAULT_URI=http://localhost
DATABASE_URL="postgresql://app:app@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
REDIS_URL="redis://127.0.0.1:6379"
MESSENGER_TRANSPORT_OUTBOX="doctrine://default?queue_name=outbox"
MESSENGER_TRANSPORT_JOBS="redis://127.0.0.1:6379/jobs"
MESSENGER_TRANSPORT_FAILED="doctrine://default?queue_name=failed"
MAILER_DSN=null://null
MAILER_FROM=noreply@localhost
MAILER_REPLY_TO=support@localhost
MERCURE_URL=http://127.0.0.1/.well-known/mercure
MERCURE_PUBLIC_URL=http://127.0.0.1/.well-known/mercure
MERCURE_JWT_SECRET=
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=
APP_ENCRYPTION_KEY=
STORAGE_DSN=local://var/storage
STORAGE_MAX_UPLOAD_MB=25
APP_URL=
MANAGER_URL=
SITE_URL=
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###
