{
  "components": {
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "description": "A JWT from /api/auth/login (tenant) or /api/manager/login\n(operator), or an API key (`sk_…`).\n",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Two realms share this API and one signing key. A token carries an\n`aud` claim (`app`, `manager` or `api_key`) and is refused by any\nfirewall it does not name - see ADR-0007.\n",
    "title": "OpenEnu API",
    "version": "0.1.0"
  },
  "openapi": "3.0.0",
