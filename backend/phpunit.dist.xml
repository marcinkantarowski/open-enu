<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         executionOrder="depends,defects"
         failOnRisky="true"
         failOnWarning="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnTestsThatTriggerErrors="true">

    <php>
        <ini name="display_errors" value="1"/>
        <ini name="error_reporting" value="-1"/>
        <server name="APP_ENV" value="test" force="true"/>
        <server name="SHELL_VERBOSITY" value="-1"/>
    </php>

    <testsuites>
        <!-- The framework package's own tests, including the architecture rules.
             These must pass before anything else is worth running: they are what
             proves the guardrails still fire. -->
        <testsuite name="kernel">
            <directory>kernel/tests</directory>
        </testsuite>

        <!-- Coverage checks that need the real container: what is MISSING,
             which static analysis of one file at a time cannot see. -->
        <testsuite name="arch">
            <directory>tests/Arch</directory>
        </testsuite>

        <!-- Cross-cutting security properties. Deliberately app-level rather
             than per-module: tenant isolation is a property of the SYSTEM, and
             testing it inside one module would only prove that module. -->
        <testsuite name="security">
            <directory>tests/Security</directory>
        </testsuite>

        <!-- Search: a property of the SYSTEM - a module's declaration, the
             write-through listener, the indexer's SQL and the tenant predicate
             inside it. Testing it in one module would only prove that module. -->
        <testsuite name="search">
            <directory>tests/Search</directory>
        </testsuite>

        <!-- Module unit tests. No container, no database, fast. -->
        <testsuite name="unit">
            <directory>src/Module/*/Tests/Unit</directory>
        </testsuite>

        <!-- Module functional tests: real HTTP through the kernel, real database.
             Slower, and the only kind that can prove an endpoint works. -->
        <testsuite name="functional">
            <directory>src/Module/*/Tests/Functional</directory>
            <!-- Endpoints the KERNEL owns and no module does: health, realtime.
                 Inside a module they would look like that module's, and the
                 next person would move them when the module moved. -->
            <directory>tests/Functional</directory>
        </testsuite>
    </testsuites>

    <source ignoreIndirectDeprecations="true" restrictNotices="true" restrictWarnings="true">
        <include>
            <directory>src</directory>
            <directory>kernel/src</directory>
        </include>
        <exclude>
            <!-- Generated by Doctrine; not our code to test. -->
            <directory>src/Module/*/Migrations</directory>
        </exclude>
    </source>
</phpunit>
