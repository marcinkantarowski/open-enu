# Test environment defaults. COMMITTED - no real secrets belong here.
#
# Symfony deliberately does NOT load .env.local when APP_ENV=test, so a test run
# never inherits a developer's machine. That means everything a test needs must
# be set here, explicitly.

APP_SECRET='$ecretf0rt3st'
APP_STAGE=local
DEFAULT_URI=http://localhost

# Fixed, obviously-fake key. Encryption must be ON in tests: turning it off
# would mean the encrypted-column path is never exercised until production.
APP_ENCRYPTION_KEY='test-only-encryption-key-not-a-secret-0123456789'

# The test database is the dev one with a _test suffix, added by
# doctrine.dbal.dbname_suffix under when@test.
KERNEL_CLASS='App\Kernel'
SYMFONY_DEPRECATIONS_HELPER=999999

# Neither transport is exercised by tests; pointing them at in-memory keeps the
# container buildable without Redis.
MESSENGER_TRANSPORT_OUTBOX=in-memory://
MESSENGER_TRANSPORT_JOBS=in-memory://
MESSENGER_TRANSPORT_FAILED=in-memory://

MAILER_DSN=null://null
STORAGE_DSN=local://var/storage

# Hosts the suite builds links against. Fixed values, not the developer's
# domain, so an email assertion means the same thing on every machine.
APP_URL=https://app.test.local
MANAGER_URL=https://manager.test.local
SITE_URL=https://test.local
MAILER_FROM=noreply@test.local
MAILER_REPLY_TO=support@test.local
