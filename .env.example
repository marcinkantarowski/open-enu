# =============================================================================
#  Stack configuration - the ONE file you edit by hand.
# =============================================================================
#  `make env` copies this to .env and fills every __GENERATE__ marker with a
#  fresh random secret. Existing values in .env are NEVER overwritten, which is
#  what makes `make buildprod` safe to re-run against a live server.
#
#  Every per-app env file (backend/.env.local, frontend/.env, manager/.env,
#  landing/.env) is DERIVED from this one - never hand-written - so hostnames,
#  CORS origins and Mercure URLs can never disagree. See .ai/platform/PLAN.md §11.
# =============================================================================

# ── Identity ─────────────────────────────────────────────────────────────────
# Changed by `make init NAME=...`, not by hand.
PROJECT_NAME=OpenEnu
PROJECT_SLUG=open-enu

# ── Host identity (filled automatically by `make env`) ──────────────────────
# The dev containers run PHP as this uid/gid so files they write into the
# bind-mounted source belong to you, not to root.
HOST_UID=1000
HOST_GID=1000

# ── Environment ──────────────────────────────────────────────────────────────
# APP_ENV   : Symfony environment. Only ever `dev`, `prod` or `test`.
# APP_STAGE : where this checkout runs - `local`, `staging` or `production`.
#             Staging is the DEV stack on a server (APP_ENV=dev, hot reload,
#             Mailpit), so you can vibe code on it; production is immutable
#             images. Drives noindex headers, demo seeding and the Sentry
#             environment tag.
APP_ENV=dev
APP_STAGE=local
APP_DEBUG=1

# ── Stack ────────────────────────────────────────────────────────────────────
# STACK        : the compose project, and the prefix of every container, network,
#                volume and router. Locally the project slug; on a server
#                <slug>-staging or <slug>-prod, so both stages can share one box.
# COMPOSE_FILE : compose's own variable, so a bare `docker compose ps` in the
#                checkout reads the right files. Staging on a server is
#                `docker/compose.dev.yml:docker/compose.staging.yml`.
STACK=open-enu
COMPOSE_FILE=docker/compose.dev.yml

# STAGING_ALLOW_FROM : who may reach a STAGING server at all - comma-separated
#                      IPs or CIDRs. Staging runs the dev stack (profiler, dev
#                      errors, Vite's dev server), which must never be public.
#                      Provisioning fills in the address you connected from.
STAGING_ALLOW_FROM=

# ── Domain ───────────────────────────────────────────────────────────────────
# One base domain drives every host: the apex is the landing page, and
# app./manager./api./mercure. hang off it. Changing this is the only edit
# needed to move the whole stack to another domain.
DOMAIN=open-enu.local

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DB_NAME=open_enu
DB_USER=open_enu
DB_PASSWORD=__GENERATE__
# Published on the host in dev only. The one port a second project on the same
# Docker host must change - routing is shared through the edge, this is not.
DB_PORT=5432

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=__GENERATE__

# ── Application secrets ──────────────────────────────────────────────────────
# APP_SECRET          : Symfony CSRF/signing secret.
# JWT_PASSPHRASE      : protects the JWT private key on disk.
# MERCURE_JWT_SECRET  : signs Mercure publisher/subscriber tokens.
# APP_ENCRYPTION_KEY  : master key for #[Encrypted] fields. Per-tenant data keys
#                       are derived from it by HKDF, so losing it loses the data.
#                       It is included in the encrypted backup bundle (.ai/platform/PLAN.md §9.3).
APP_SECRET=__GENERATE__
JWT_PASSPHRASE=__GENERATE__
MERCURE_JWT_SECRET=__GENERATE__
APP_ENCRYPTION_KEY=__GENERATE__

# ── Mail ─────────────────────────────────────────────────────────────────────
# Dev captures everything in Mailpit. Production REFUSES TO START without a real
# DSN - silently dropping mail in production is worse than failing loudly.
MAILER_DSN=smtp://mailpit:1025
MAILER_FROM=noreply@open-enu.local
MAILER_REPLY_TO=support@open-enu.local

# ── File storage ─────────────────────────────────────────────────────────────
# STORAGE_DSN: `local://var/storage` in dev, or an S3-compatible URL in prod:
#   s3://KEY:SECRET@ENDPOINT/BUCKET?region=eu-central-1
STORAGE_DSN=local://var/storage
STORAGE_MAX_UPLOAD_MB=25

# ── Optional integrations (empty = feature is a no-op, never a crash) ────────
# SENTRY_DSN                  : error tracking, all four apps.
# OTEL_EXPORTER_OTLP_ENDPOINT : OpenTelemetry traces/metrics. Off unless set.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Backups (REQUIRED for `make buildprod`, optional for staging) ────────────
# BACKUP_REMOTE     : any rclone remote, e.g. `s3:my-bucket/open-enu`.
#                     `buildprod` refuses to finish without a reachable one.
# BACKUP_AGE_PUBKEY : age public key the nightly dump is encrypted to. Keep the
#                     private half somewhere that is NOT this server.
BACKUP_REMOTE=
BACKUP_AGE_PUBKEY=
# BACKUP_AGE_KEY_FILE : path on the SERVER to the private half. Deliberately
#                       empty: a key stored beside the backups it decrypts
#                       protects against disk failure and nothing else. Set it
#                       only for an automated restore you have decided to accept.
BACKUP_AGE_KEY_FILE=

# ── TLS ──────────────────────────────────────────────────────────────────────
# LETSENCRYPT_EMAIL : where expiry warnings go. Required in production - ACME
#                     registration fails without it, at the point where nothing
#                     has a certificate yet.
# LE_CA_SERVER      : the ACME directory. Production's by default, for staging
#                     too: a staging CA certificate is untrusted by browsers,
#                     and staging is where you work in one. Point it at
#                     https://acme-staging-v02.api.letsencrypt.org/directory
#                     while debugging DNS - five failed authorisations an hour
#                     locks a hostname out for a week.
LETSENCRYPT_EMAIL=
LE_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory

